from functools import reduce

(lambda students, compose, cmap, cfilter, creduce, get, greater: tuple(map(
    # ОТЛОЖЕННОЕ: уровни - лямбды без аргументов, выполняются при thunk()
    lambda thunk: thunk(),
    (
        # ОТЛОЖЕННОЕ: cmap ленивый, вычисляется при сборке кортежа
        lambda: tuple(cmap(
            lambda s: f"Имя: {s['name']}, Оценка: {s['grade']}"
        )(students)),
        # ОТЛОЖЕННОЕ: cfilter ленивый, вычисляется при сборке кортежа
        lambda: tuple(cfilter(greater(4.0)("grade"))(students)),
        lambda: compose(
            # ОТЛОЖЕННОЕ: вычисляется только внутри creduce
            cfilter(greater(4.0)("grade")),
            cmap(get("age")),
            creduce(lambda acc, age: (acc[0] + age, acc[1] + 1))((0, 0)),
            lambda total: total[0] / total[1],
        )(students),
    ),
)))(
    (
        {"name": "Анна", "age": 20, "grade": 4.5},
        {"name": "Борис", "age": 22, "grade": 3.8},
        {"name": "Виктор", "age": 19, "grade": 4.2},
        {"name": "Галина", "age": 21, "grade": 4.9},
        {"name": "Дмитрий", "age": 23, "grade": 3.5},
    ),
    lambda *fs: reduce(lambda f, g: lambda x: g(f(x)), fs),
    lambda f: lambda items: map(f, items),
    lambda pred: lambda items: filter(pred, items),
    lambda f: lambda init: lambda items: reduce(f, items, init),
    lambda key: lambda item: item[key],
    lambda threshold: lambda key: lambda item: item[key] > threshold,
)
